# Fleet training RayJob, every node count (rendered by submit_run.py; do
# not kubectl-apply directly). workers=1 is a head with zero worker pods.
#
# Shape: Kueue label + suspend:true, a submitter on a CPU node, and the
# entrypoint running on the head. Deltas for miles:
#   * the head is a GPU pod (miles colocates trainer + engines on every GPU),
#     with the dind sidecar and flt store, because the rollout manager is
#     pinned to the head (--pin-rollout-manager-to-head) and drives the
#     environment containers through DOCKER_HOST there. Workers are
#     unprivileged GPU pods.
#   * miles joins the KubeRay cluster instead of starting its own:
#     MILES_SCRIPT_EXTERNAL_RAY=1.
#   * GPU podsets request tier-2 topology: each node is its own tier-1
#     (rack) domain, so a gang spanning nodes must bind at the spine.
# torch-dist across nodes needs no address plumbing: miles's rank-0 actor
# publishes its own node IP and port to the other ranks.
apiVersion: ray.io/v1
kind: RayJob
metadata:
  name: ${JOB_NAME}
  namespace: fleet-train-jobs
  labels:
    app: miles-fleet
    owner: ${OWNER}
    kueue.x-k8s.io/queue-name: training-lq
  annotations:
    fleet.ai/submitted-by: ${SUBMITTED_BY}
spec:
  suspend: true                      # Kueue unsuspends on gang admission
  shutdownAfterJobFinishes: true
  # 0, not a day: this TTL delays the RAY CLUSTER teardown after the job
  # finishes, so a nonzero value keeps the GPUs reserved that long (found by
  # teammates on 2026-08-27: two finished smokes squatting their nodes). The
  # log survives on SFS and metrics on WandB; nothing needs the dead cluster.
  ttlSecondsAfterFinished: 0
  # Platform-only entrypoint: the code side (taskset pull, dataset build,
  # image pre-pull, model prep, training) lives in the image and is invoked
  # by the payload command. Single-quoted: no apostrophes in COMMAND.
  entrypoint: |
    bash -c '
    set -euo pipefail
    cd /root/miles
    exec ${COMMAND}
    '
  submitterPodTemplate:
    metadata:
      labels: {owner: ${OWNER}}
    spec:
      restartPolicy: Never
      nodeSelector: {kubernetes.io/os: linux, workload: ${CPU_WORKLOAD}}
      tolerations:
        - {key: workload, operator: Exists, effect: NoSchedule}
      containers:
        - name: ray-job-submitter
          # Slim ray image matching the trainer image's ray (2.58.0): the
          # submitter only runs `ray job submit`; the 30GB trainer image
          # would fill the small infra nodes.
          image: rayproject/ray:2.58.0-py312
          env:
            - {name: NVIDIA_VISIBLE_DEVICES, value: void}
          resources:
            requests: {cpu: 200m, memory: 512Mi, ephemeral-storage: 2Gi}
            limits: {cpu: "1", memory: 1Gi}
  rayClusterSpec:
    rayVersion: "2.58.0"
    headGroupSpec:
      rayStartParams:
        dashboard-host: "0.0.0.0"
      template:
        metadata:
          labels: {app: miles-fleet, owner: ${OWNER}, run: "${JOB_NAME}"}
          annotations:
            kueue.x-k8s.io/podset-required-topology: topology.nebius.com/tier-2
        spec:
          # Same class the platform's ft-runs use (value 10000). Without it
          # our workloads sit at priority 0 and get preempted mid-run by any
          # ft-run (observed: miles-glm53-smoke evicted 2026-08-29 04:59).
          priorityClassName: fleet-train-high
          nodeSelector:
            kubernetes.io/os: linux
            workload: ${NODE_WORKLOAD}
            node.kubernetes.io/instance-type: ${INSTANCE_TYPE}
          tolerations:
            - {key: workload, operator: Exists, effect: NoSchedule}
          imagePullSecrets:
            - name: ghcr-pull
          volumes:
            - name: sfs
              persistentVolumeClaim: {claimName: sfs-shared}
            - name: flt-root
              emptyDir: {}
            - name: dind-storage
              emptyDir: {}
            - name: shm
              emptyDir: {medium: Memory, sizeLimit: 32Gi}
          initContainers:
            - name: sfs-init
              image: busybox:1.36
              securityContext: {runAsUser: 0}
              command: ["sh", "-c", "mkdir -p /mnt/sfs/miles-fleet/${JOB_NAME} /mnt/sfs/miles-fleet/models"]
              volumeMounts:
                - {name: sfs, mountPath: /mnt/sfs}
            - name: dind
              image: docker:27-dind
              restartPolicy: Always
              securityContext: {privileged: true}
              env:
                - {name: DOCKER_TLS_CERTDIR, value: ""}
              args:
                - "--host=tcp://0.0.0.0:2375"
                - "--default-address-pool"
                - "base=10.201.0.0/16,size=24"
                - "--feature"
                - "containerd-snapshotter=true"
              volumeMounts:
                - {name: flt-root, mountPath: /root/.flt}
                - {name: sfs, mountPath: /mnt/sfs}
                - {name: dind-storage, mountPath: /var/lib/docker}
              resources:
                requests: {cpu: "8", memory: 16Gi}
                limits: {memory: 24Gi}
          containers:
            - name: ray-head
              image: ${IMAGE}
              # privileged for two measured reasons: (1) sglang engine
              # subprocesses share CUDA memory via pidfd_getfd, denied by the
              # default seccomp profile; (2) on the Nebius cluster the
              # InfiniBand devices are exposed to privileged containers, and
              # that is what carries cross-node NCCL at fabric speed (the
              # cluster's own nccl-test measured 473 GB/s cross-rack with
              # exactly this: privileged + 8 GPUs, nothing else)
              securityContext:
                privileged: true
              env:
                - {name: DOCKER_HOST, value: "tcp://127.0.0.1:2375"}
                - {name: WANDB_ENTITY, value: thefleet}
                - {name: FLEET_FLT, value: /usr/local/bin/flt}${EXTRA_ENV}
              envFrom:
                - secretRef: {name: ${SECRET_NAME}}
                - secretRef: {name: wandb-api}
              volumeMounts:
                - {name: sfs, mountPath: /mnt/sfs}
                - {name: flt-root, mountPath: /root/.flt}
                - {name: shm, mountPath: /dev/shm}
              resources:
                requests: {cpu: "48", memory: ${MAIN_MEM}, nvidia.com/gpu: ${NUM_GPUS}}
                limits: {cpu: "64", memory: ${MAIN_MEM_LIM}, nvidia.com/gpu: ${NUM_GPUS}}
    workerGroupSpecs:
      - groupName: gpu-worker
        replicas: ${WORKER_REPLICAS}
        minReplicas: ${WORKER_REPLICAS}
        maxReplicas: ${WORKER_REPLICAS}
        rayStartParams: {}
        template:
          metadata:
            labels: {app: miles-fleet, owner: ${OWNER}, run: "${JOB_NAME}"}
            annotations:
              kueue.x-k8s.io/podset-required-topology: topology.nebius.com/tier-2
          spec:
            priorityClassName: fleet-train-high
            nodeSelector:
              kubernetes.io/os: linux
              workload: ${NODE_WORKLOAD}
              node.kubernetes.io/instance-type: ${INSTANCE_TYPE}
            tolerations:
              - {key: workload, operator: Exists, effect: NoSchedule}
            imagePullSecrets:
              - name: ghcr-pull
            volumes:
              - name: sfs
                persistentVolumeClaim: {claimName: sfs-shared}
              - name: shm
                emptyDir: {medium: Memory, sizeLimit: 32Gi}
            containers:
              - name: ray-worker
                image: ${IMAGE}
                securityContext:
                  privileged: true
                env:${WORKER_EXTRA_ENV}
                envFrom:
                  - secretRef: {name: ${SECRET_NAME}}
                  - secretRef: {name: wandb-api}
                volumeMounts:
                  - {name: sfs, mountPath: /mnt/sfs}
                  - {name: shm, mountPath: /dev/shm}
                resources:
                  requests: {cpu: "48", memory: ${MAIN_MEM}, nvidia.com/gpu: ${NUM_GPUS}}
                  limits: {cpu: "64", memory: ${MAIN_MEM_LIM}, nvidia.com/gpu: ${NUM_GPUS}}

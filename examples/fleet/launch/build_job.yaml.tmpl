# In-cluster trainer-image build (rendered by build_image.sh via envsubst).
# One pod: dind native-sidecar daemon + docker CLI client that clones
# fleet-ai/miles-fleet at ${REF}, builds the trainer Dockerfile, pushes to
# ghcr.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${BUILD_JOB}
  namespace: fleet-train-jobs
  labels:
    app: img-build
    kueue.x-k8s.io/queue-name: default
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 14400
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels: {app: img-build}
    spec:
      restartPolicy: Never
      # A GPU node, not the CPU pool: the image unpacks to well over 100GB
      # (a ~94GB-ephemeral builder was evicted at 19 min on 2026-08-21); the
      # GPU nodes have ~956GB ephemeral. The pod requests no GPUs; builds are
      # rare and the dind storage dies with the pod.
      nodeSelector: {workload: fleetai-training-ng-gpu}
      tolerations:
        - {key: workload, operator: Exists, effect: NoSchedule}
      volumes:
        - {name: dind-storage, emptyDir: {}}
      initContainers:
        - name: dind
          image: docker:27-dind
          restartPolicy: Always
          securityContext: {privileged: true}
          env: [{name: DOCKER_TLS_CERTDIR, value: ""}]
          args: ["--host=tcp://0.0.0.0:2375"]
          volumeMounts:
            - {name: dind-storage, mountPath: /var/lib/docker}
          resources:
            requests: {cpu: "3500m", memory: 10Gi}
            limits: {memory: 14Gi}
      containers:
        - name: build
          image: docker:27-cli
          envFrom: [{secretRef: {name: img-build-secrets}}]
          env:
            - {name: DOCKER_HOST, value: "tcp://127.0.0.1:2375"}
            - {name: SHA, value: "${SHA}"}
            - {name: SOURCE_REPOSITORY, value: "${SOURCE_REPOSITORY}"}
            - {name: REF, value: "${REF}"}
            - {name: EXPECTED_COMMIT, value: "${EXPECTED_COMMIT}"}
            - {name: CACHE_TAG, value: "${CACHE_TAG}"}
          resources:
            requests: {cpu: "1", memory: 2Gi}
            limits: {memory: 3Gi}
          command: ["sh", "-c"]
          args:
            - |
              set -eu
              apk add --no-cache git >/dev/null
              for i in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 2; done
              git init -q /w
              cd /w
              git remote add origin "https://x-access-token:${GH_TOKEN}@github.com/${SOURCE_REPOSITORY}.git"
              git fetch -q --depth 1 origin "${REF}"
              FETCHED_COMMIT=$(git rev-parse FETCH_HEAD)
              test "$FETCHED_COMMIT" = "$EXPECTED_COMMIT" || {
                echo "fetched commit $FETCHED_COMMIT does not match expected $EXPECTED_COMMIT" >&2
                exit 1
              }
              git checkout -q --detach FETCH_HEAD
              echo "${GH_TOKEN}" | docker login ghcr.io -u x --password-stdin
              # Cache warming is optional. Registry stalls must not spend the
              # entire four-hour build deadline before the real build starts.
              timeout 300 docker pull "ghcr.io/fleet-ai/miles-fleet/trainer:${CACHE_TAG}" >/dev/null 2>&1 || true
              export GH_TOKEN
              DOCKER_BUILDKIT=1 docker build -f examples/fleet/launch/Dockerfile \
                --cache-from "ghcr.io/fleet-ai/miles-fleet/trainer:${CACHE_TAG}" \
                --secret id=gh_token,env=GH_TOKEN \
                -t "ghcr.io/fleet-ai/miles-fleet/trainer:${SHA}" \
                .
              docker push "ghcr.io/fleet-ai/miles-fleet/trainer:${SHA}"
              echo "IMAGE PUSHED: ${SHA} FROM ${FETCHED_COMMIT}"
